name: CI - Kind + Playwright

on:
  push:
    branches: [ main, master ]
  pull_request:

jobs:
  e2e:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # ---- Build JAR ----
      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "11"
          cache: maven

      - name: Build jar (skip tests)
        run: mvn -q -DskipTests clean package

      # ---- Build Docker image ----
      - name: Build docker image
        run: docker build -t fake-user-app:ci .

      # ---- Create kind cluster ----
      - name: Create kind cluster
        uses: helm/kind-action@v1
        with:
          cluster_name: ci

      - name: Load image into kind
        run: kind load docker-image fake-user-app:ci --name ci

      # ---- Deploy to Kubernetes ----
      - name: Apply manifests
        run: |
          kubectl apply -f k8s/namespace.yaml
          kubectl apply -f k8s/postgres.yaml
          kubectl apply -f k8s/fake-user-app.yaml

          # Ensure the Deployment uses the image we built and loaded into kind
          kubectl -n fake-user-app set image deployment/fake-user-app app=fake-user-app:ci

          # Ingress is optional for CI; don't fail if it can't apply
          kubectl apply -f k8s/ingress.yaml || true

      - name: Wait for rollout
        run: |
          set -e

          # Wait for Postgres (StatefulSet). Don't fail the whole job if it takes longer.
          kubectl -n fake-user-app rollout status statefulset/my-postgres-db-2 --timeout=240s || true

          if ! kubectl -n fake-user-app rollout status deployment/fake-user-app --timeout=300s; then
            echo "---- pods ----"
            kubectl -n fake-user-app get pods -o wide || true

            echo "---- describe app pods ----"
            kubectl -n fake-user-app describe pods -l app=fake-user-app || true

            echo "---- recent events ----"
            kubectl -n fake-user-app get events --sort-by=.lastTimestamp | tail -n 200 || true

            echo "---- app logs ----"
            kubectl -n fake-user-app logs -l app=fake-user-app --tail=400 || true

            exit 1
          fi



      # ---- Cleanup ----
      - name: Cleanup
        if: always()
        run: |
          kind delete cluster --name ci